# ==============================================================================
# Overleaf / Collabtex Strict Whitelist Ignore Rules (.olignore)
# Whitelist: Source .tex, .bib, tables/*,
#            figures/ (*.pdf and *.png only, *.svg and archives excluded)
# ==============================================================================

# Directories to ignore entirely
build/*
build/**
.history/*
.history/**
.agents/*
.agents/**
.vscode/*
.vscode/**
literature/*
literature/**
scripts/*
scripts/**
FIG.Assets/*
FIG.Assets/**
FIG.Data/*
FIG.Data/**
figures/old/*
figures/old/**
figures/legacy/*
figures/legacy/**

# Figures formatting: ignore SVG, scripts, spreadsheets, backups, and caches (Keep only PDF & PNG)
*.svg
figures/*.svg
figures/**/*.svg
figures/*.bat
figures/*.py
figures/*.xlsx
*.bak
figures/*.bak
figures/**/*.bak
figures/.bak/*
figures/.bak/**
figures/.fig_cache.json

# Legacy / historical figure versions (Keep only current production PDF & PNG)
*_ver*
*_ver*.*
figures/*_ver*
figures/*_ver*.*
figures/**/*_ver*.*
*_legacy*
*_legacy*.*
figures/*_legacy*
figures/*_legacy*.*
figures/**/*_legacy*.*

# Root compiled PDFs (Overleaf compiles its own PDF; do not upload local build PDF)
main.pdf
SupplementalMaterial.pdf
PRFluidsSupplementalMaterial.pdf

# Documentation, system files, dev configs, and sync state
*.md
*.synctex.gz
*.synctex
*.synctex(busy)
*.ps1
*.bat
*.pl
*.lgpl
*.code-workspace
.latexmkrc
.olauth
.olignore
.olproject
.collabtex_cache/*
.collabtex_cache/**
.stignore
.olsync*
*.olsync*
.DS_Store
Thumbs.db
Desktop.ini

# LaTeX compilation auxiliary files
*.aux
*.bbl
*.blg
*.log
*.out
*.fls
*.fdb_latexmk
*.toc
*.lof
*.lot
*.bcf
*.run.xml
*Notes.bib
*.xdv
